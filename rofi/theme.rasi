/* ~/.config/rofi/theme.rasi — Material You launcher
 * colours: ~/.config/rofi/colors.rasi (generated by matugen) */
@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @on-surface;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            580px;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    24px;
    background-color: @surface-a;
}

mainbox {
    padding:  16px;
    spacing:  14px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          12px 18px;
    spacing:          14px;
    border-radius:    18px;
    background-color: @surface-container-high;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @primary;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @on-surface-variant;
    text-color:        @on-surface;
    cursor-color:      @primary;
    vertical-align:    0.5;
}

listview {
    lines:        7;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
    cycle:        true;
}

element {
    padding:       10px 14px;
    spacing:       14px;
    border-radius: 16px;
    orientation:   horizontal;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @on-surface;
}

element selected.normal {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element normal.active,
element alternate.active {
    text-color: @tertiary;
}

element selected.active {
    background-color: @tertiary-container;
    text-color:       @on-tertiary-container;
}

element normal.urgent,
element alternate.urgent {
    text-color: @error;
}

element selected.urgent {
    background-color: @error-container;
    text-color:       @on-error-container;
}

element-icon {
    size:           34px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

message {
    padding:          12px 16px;
    border-radius:    16px;
    background-color: @surface-container;
}

textbox {
    text-color: @on-surface;
}
