;; ~/.config/eww/eww.yuck — control panel docked to the right (toggle: SUPER + A)
;; Anchored top-right, 62px down so it sits below waybar. No fixed height: it is exactly as tall as its content.

(defwindow control_panel
  :monitor 0
  :geometry (geometry :x "12px"
                      :y "10px"
                      :width "350px"
                      :anchor "top right")
  :stacking "fg"
  :exclusive false
  :namespace "eww-panel"   ;; matched by the Hyprland layer rules (slide + blur)
  (box :class "panel-box" :orientation "vertical" :space-evenly false :spacing 10

    ;; ── Header ───────────────────────────────────────────────
    (box :class "header" :orientation "horizontal" :space-evenly false :spacing 12
      (label :class "header-avatar icon" :text "󰀄")
      (box :orientation "vertical" :space-evenly false :spacing 2 :hexpand true :valign "center"
        (label :class "header-name" :text {username} :halign "start" :show_truncated false)
        (label :class "header-sub"  :text {"up " + uptime} :halign "start" :show_truncated false))
      (label :class "battery-pill" :text {"󰁹  " + battery + "%"} :show_truncated false))

    ;; ── Quick settings ───────────────────────────────────────
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 8
      (label :class "section-title" :text "QUICK SETTINGS" :halign "start" :show_truncated false)
      (box :orientation "horizontal" :space-evenly true :spacing 8
        (button :class {wifi_status == "on" ? "toggle-btn active" : "toggle-btn"}
                :onclick "nmcli radio wifi $(nmcli radio wifi | grep -q enabled && echo off || echo on)"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰖩")
            (label :class "btn-label" :text "Wi-Fi" :show_truncated false)))

        (button :class {bt_status == "on" ? "toggle-btn active" : "toggle-btn"}
                :onclick "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰂯")
            (label :class "btn-label" :text "Bluetooth" :show_truncated false)))))

    ;; ── Sliders ──────────────────────────────────────────────
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 8
      (label :class "section-title" :text "CONTROLS" :halign "start" :show_truncated false)

      (box :class "slider-container" :orientation "horizontal" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰕾")
        (scale :class "slider"
               :value current_volume
               :orientation "horizontal"
               :max 100
               :min 0
               :hexpand true
               :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"))

      (box :class "slider-container" :orientation "horizontal" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰃠")
        (scale :class "slider"
               :value current_brightness
               :orientation "horizontal"
               :max 100
               :min 0
               :hexpand true
               :onchange "brightnessctl set {}%")))

    ;; ── Applications ─────────────────────────────────────────
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 8
      (label :class "section-title" :text "APPLICATIONS" :halign "start" :show_truncated false)
      (box :orientation "horizontal" :space-evenly true :spacing 8
        (button :class "app-btn" :onclick "eww close control_panel; codium &"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon app-icon" :text "󰨞")
            (label :class "btn-label" :text "Codium" :show_truncated false)))

        (button :class "app-btn" :onclick "eww close control_panel; zen-browser &"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon app-icon" :text "󰖟")
            (label :class "btn-label" :text "Zen" :show_truncated false)))

        (button :class "app-btn" :onclick "eww close control_panel; alacritty &"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon app-icon" :text "󰞷")
            (label :class "btn-label" :text "Terminal" :show_truncated false)))))

    ;; ── Power (one row of four) ──────────────────────────────
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 8
      (label :class "section-title" :text "POWER" :halign "start" :show_truncated false)
      (box :orientation "horizontal" :space-evenly true :spacing 6
        (button :class "power-btn" :onclick "hyprctl dispatch 'hl.dsp.exit()'"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰍃")
            (label :class "btn-label" :text "Exit" :show_truncated false)))
        (button :class "power-btn" :onclick "systemctl suspend"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰤄")
            (label :class "btn-label" :text "Sleep" :show_truncated false)))
        (button :class "power-btn" :onclick "systemctl reboot"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰜉")
            (label :class "btn-label" :text "Reboot" :show_truncated false)))
        (button :class "power-btn" :onclick "systemctl poweroff"
          (box :orientation "vertical" :space-evenly false :spacing 2 :halign "center"
            (label :class "icon" :text "󰐥")
            (label :class "btn-label" :text "Off" :show_truncated false)))))))

;; ── Dynamic variables ────────────────────────────────────────

(defpoll username :interval "1h" :initial "user"
  "whoami")

(defpoll uptime :interval "60s" :initial "…"
  "uptime -p | sed 's/^up //'")

(defpoll battery :interval "30s" :initial "100"
  'b=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1); echo "\${b:-100}"')

(defpoll current_volume :interval "2s" :initial "0"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'")

(defpoll current_brightness :interval "2s" :initial "50"
  'echo $(( $(cat /sys/class/backlight/*/brightness) * 100 / $(cat /sys/class/backlight/*/max_brightness) ))')

(defpoll wifi_status :interval "3s" :initial "off"
  'nmcli radio wifi | grep -q enabled && echo on || echo off')

(defpoll bt_status :interval "3s" :initial "off"
  'bluetoothctl show | grep -q "Powered: yes" && echo on || echo off')
