;; Windows Configuration (Docked to the Right)
(defwindow control_panel
  :monitor 0
  :geometry (geometry :x "16px"
                      :y "0px"
                      :width "330px"
                      :height "90%"
                      :anchor "right center")
  :stacking "fg"
  :exclusive true
  (box :class "panel-box" :orientation "vertical" :space-evenly false :spacing 14
    
    ;; Section 1: Quick Settings (Network & Bluetooth Only)
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 12
      (label :class "section-title" :text "QUICK SETTINGS" :halign "start")
      (box :orientation "horizontal" :space-evenly true :spacing 10
        (button :class {wifi_status == "on" ? "toggle-btn active" : "toggle-btn"}
                :onclick "hyprctl dispatch exec nmcli radio wifi $(nmcli radio wifi | grep -q enabled && echo off || echo on)"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰖩")
            (label :class "btn-label" :text "Wi-Fi" :limit-width 9 :show_truncated true)))

        (button :class {bt_status == "on" ? "toggle-btn active" : "toggle-btn"}
                :onclick "hyprctl dispatch exec bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰂯")
            (label :class "btn-label" :text "Bluetooth" :limit-width 9 :show_truncated true)))))

    ;; Section 2: Controls (Sliders)
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 12
      (label :class "section-title" :text "CONTROLS" :halign "start")

      (box :class "slider-container" :orientation "horizontal" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰕾")
        (scale :class "slider"
               :value current_volume
               :orientation "horizontal"
               :max 100
               :min 0
               :hexpand true
               :onchange "amixer -D pulse sset Master {}%"))

      (box :class "slider-container" :orientation "horizontal" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰃠")
        (scale :class "slider"
               :value current_brightness
               :orientation "horizontal"
               :max 100
               :min 0
               :hexpand true
               :onchange "brightnessctl set {}%")))

    ;; Section 3: Applications
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 12
      (label :class "section-title" :text "APPLICATIONS" :halign "start")
      (box :orientation "horizontal" :space-evenly true :spacing 10
        (button :class "app-btn" :onclick "hyprctl dispatch exec codium && eww close control_panel"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon app-icon" :text "󰨞")
            (label :class "btn-label" :text "Codium" :limit-width 9 :show_truncated true)))

        (button :class "app-btn" :onclick "hyprctl dispatch exec zen-browser && eww close control_panel"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon app-icon" :text "󰖟")
            (label :class "btn-label" :text "Zen" :limit-width 9 :show_truncated true)))

        (button :class "app-btn" :onclick "hyprctl dispatch exec alacritty && eww close control_panel"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon app-icon" :text "󰞷")
            (label :class "btn-label" :text "Terminal" :limit-width 9 :show_truncated true)))))

    ;; Section 4: Power Options (Expanded with Sleep & Reboot)
    (box :class "section" :orientation "vertical" :space-evenly false :spacing 12
      (label :class "section-title" :text "SYSTEM POWER" :halign "start")
      
      ;; Top row: Log Out & Sleep
      (box :orientation "horizontal" :space-evenly true :spacing 10
        (button :class "power-btn" :onclick "hyprctl dispatch exit"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰐥")
            (label :class "btn-label" :text "Log Out" :limit-width 9 :show_truncated true)))
        (button :class "power-btn" :onclick "hyprctl dispatch exec systemctl suspend"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰤄")
            (label :class "btn-label" :text "Sleep" :limit-width 9 :show_truncated true))))
      
      ;; Bottom row: Reboot & Shut Down
      (box :orientation "horizontal" :space-evenly true :spacing 10
        (button :class "power-btn" :onclick "hyprctl dispatch exec systemctl reboot"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰜉")
            (label :class "btn-label" :text "Reboot" :limit-width 9 :show_truncated true)))
        (button :class "power-btn" :onclick "hyprctl dispatch exec systemctl poweroff"
          (box :orientation "vertical" :space-evenly false :spacing 4 :halign "center"
            (label :class "icon" :text "󰐥")
            (label :class "btn-label" :text "Shut Down" :limit-width 12 :show_truncated true)))))))

;; Dynamic Variables (Polled Scripts)
(defpoll current_volume :interval "1s" "amixer -D pulse sget Master | grep -oP '\\[\\d+%\\]' | head -n1 | tr -d '[]%'")
(defpoll current_brightness :interval "1s" "brightnessctl i | grep -oP '\\(\\d+%\\)' | tr -d '(%)'")
(defpoll wifi_status :interval "1s" "nmcli radio wifi | grep -q enabled && echo 'on' || echo 'off'")
(defpoll bt_status :interval "1s" "bluetoothctl show | grep -q 'Powered: yes' && echo 'on' || echo 'off'")